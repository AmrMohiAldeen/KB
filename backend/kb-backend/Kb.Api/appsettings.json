{
  "Drafts": {
    "MaxContentSizeBytes": 2097152
  },
  "Media": {
    "MaxFileSizeBytes": 104857600
  },
  "Migrations": {
    "HelpJuice": {
      "MaxPackageSizeBytes": 536870912,
      "MaxExtractedSizeBytes": 2147483648,
      "MaxEntrySizeBytes": 268435456,
      "MaxEntries": 20000,
      "MaxCsvRows": 500000,
      "BatchSize": 50,
      "MaxCompressionRatio": 200
    }
  },
  "Typesense": {
    "Endpoint": "",
    "AdminApiKey": "",
    "InternalCollectionAlias": "internal_kb_documents",
    "PublicCollectionAlias": "public_kb_documents",
    "DraftDebounceMilliseconds": 3000,
    "PollIntervalMilliseconds": 2000,
    "MaxRetries": 8
  },
  "ViewerAuthentication": {
    "Issuer": "knowledgebase",
    "Audience": "knowledgebase-viewer",
    "SessionSigningKey": "",
    "HandoffIssuer": "swiftassess",
    "HandoffAudience": "knowledgebase-handoff",
    "HandoffSigningKey": "",
    "FrontendBaseUrl": "",
    "SessionLifetimeMinutes": 60,
    "MaximumHandoffLifetimeSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
